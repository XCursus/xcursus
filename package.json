{
  "name": "xcursus",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "pnpm generate && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm generate && vitest run",
    "test:e2e": "pnpm build && node scripts/check-packages.mjs && node scripts/run-e2e.mjs",
    "test:e2e:webkit:macos14": "pnpm build && node scripts/check-packages.mjs && node scripts/run-e2e.mjs --webkit-macos14",
    "test:e2e:chrome": "pnpm build && node scripts/check-packages.mjs && playwright test --config playwright.installed.config.ts",
    "test:safari": "pnpm build && node scripts/checklist.mjs --browser safari",
    "browsers:install": "node scripts/run-e2e.mjs --install",
    "build": "pnpm generate && pnpm --filter @xcursus/core build && pnpm --filter @xcursus/impress-compat build && pnpm --filter @xcursus/player build && pnpm --filter @xcursus/plugins build && pnpm --filter @xcursus/cli build && pnpm --filter @xcursus/editor build && pnpm --filter @xcursus/playground build && pnpm --filter @xcursus/studio build",
    "dev:playground": "vite --config apps/playground/vite.config.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "dev:studio": "vite --config apps/studio/vite.config.ts",
    "xcursus": "node packages/cli/dist/cli.js",
    "test:coverage": "pnpm generate && vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@guidepup/guidepup": "0.40.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
