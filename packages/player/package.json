{
  "name": "@xcursus/player",
  "version": "0.6.0",
  "description": "Framework-free DOM/CSS 3D player of XCursus presentations: navigation, input, accessibility, renderer registry, asset resolver and capture clock.",
  "license": "GPL-3.0-or-later",
  "author": "Francesco Vitucci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XCursus/xcursus.git",
    "directory": "packages/player"
  },
  "homepage": "https://github.com/XCursus/xcursus/tree/main/packages/player#readme",
  "bugs": {
    "url": "https://github.com/XCursus/xcursus/issues"
  },
  "keywords": [
    "xcursus",
    "presentation",
    "player",
    "css-3d",
    "accessibility",
    "impress"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/browser.ts",
    "./src/iife.ts",
    "./dist/iife/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presenter": {
      "types": "./dist/presenter.d.ts",
      "import": "./dist/presenter.js"
    },
    "./style.css": "./dist/player.css",
    "./fonts.css": "./dist/fonts.css",
    "./iife": "./dist/iife/xcursus-player.iife.js",
    "./iife/style.css": "./dist/iife/player.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.iife.config.ts && node ../../scripts/player-fonts.mjs && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@xcursus/core": "workspace:*"
  }
}
