{
  "name": "@xcursus/cli",
  "version": "1.0.0",
  "description": "XCursus command line: validate projects, build static bundles and export standalone HTML, PDF and WebM from an explicit itinerary.",
  "license": "GPL-3.0-or-later",
  "author": "Francesco Vitucci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XCursus/xcursus.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/XCursus/xcursus/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/XCursus/xcursus/issues"
  },
  "keywords": [
    "xcursus",
    "presentation",
    "cli",
    "export",
    "pdf",
    "webm"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "xcursus": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build -c vite.runtime.config.ts",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "@xcursus/core": "workspace:*",
    "@xcursus/impress-compat": "workspace:*",
    "@xcursus/player": "workspace:*",
    "@xcursus/plugins": "workspace:*",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.64.1"
  }
}
